# =============================================================================
# RAG Pipeline — Environment variables
# Copy to .env and fill in values
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- OpenSearch -------------------------------------------------------------
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_INDEX_PREFIX=rag
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_MAX_RETRIES=3
OPENSEARCH_RETRY_ON_TIMEOUT=true

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_pipeline
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Embedding --------------------------------------------------------------
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# ---- LLM (OpenRouter — free models available) ------------------------------
GENERATION_PROVIDER=openrouter
GENERATION_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_API_KEY=

# ---- S3-compatible storage
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=anything
S3_SECRET_KEY=anything
S3_BUCKET=rag-documents

# ---- Firecrawl (URL ingestion) ----------------------------------------------
FIRECRAWL_API_KEY=

# ---- Observability ----------------------------------------------------------
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rag-pipeline

# ---- Grafana ----------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---- API Security -----------------------------------------------------------
API_KEYS=your-production-key-here
