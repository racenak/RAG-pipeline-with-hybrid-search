      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{ method }} {{ status }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Latency (P95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
